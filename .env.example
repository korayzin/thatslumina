# Yerel kullanımda tam yolu kullanmayın; credentials.json kullanın (.gitignore’da).
# Vercel’de ortam değişkenleri: GOOGLE_CREDENTIALS_JSON = credentials.json içeriğinin tamamı (tek JSON)
# İsteğe bağlı: GOOGLE_SHEET_ID (varsayılan kodda sabit bir ID kullanılıyor)

GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=

# SEO / canonical base URL (optional — defaults to https://www.thatslumina.com)
SITE_URL=
NEXT_PUBLIC_SITE_URL=
